# Supabase Postgres
DATABASE_URL=
DIRECT_URL=

# Supabase (server-only; never exposed to client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth (custom JWT, not Supabase Auth)
JWT_SECRET=
BOOTSTRAP_ADMIN_IDENTIFIER=
BOOTSTRAP_ADMIN_PASSWORD=

# Supabase project refs that `pnpm db:flush:dev` and `pnpm db:verify:video` may WRITE to.
# Comma-separated. If unset, both scripts refuse to run against Supabase.
#
# Why a project ref and not a hostname: Supabase routes every project through the same shared
# pooler host (`aws-<n>-<region>.pooler.supabase.com`), so dev and production are
# indistinguishable by hostname — and `NODE_ENV` is never set when running a script via tsx.
# The 20-character project ref is what actually separates them. Both scripts delete or overwrite
# real rows, so they refuse by default rather than assuming.
#
# Find your ref: the subdomain of SUPABASE_URL, or the `postgres.<ref>` username in DATABASE_URL.
DOS_DEV_PROJECT_REFS=
